# Copy this file to .env for local development.
# NEVER commit .env or real credentials.

TZ=Etc/UTC

# -----------------------------------------------------------------------------
# Activepieces
# -----------------------------------------------------------------------------

# Public/browser-facing URL for Activepieces.
#
# localhost is appropriate for initial local testing.
# Change this later if Kestrel is exposed through a reverse proxy or domain.
AP_FRONTEND_URL=http://localhost:8080

AP_ENVIRONMENT=prod

# Activepieces database
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=

# Redis
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379

# Security secrets
#
# Generate unique values in your LOCAL .env file.
AP_ENCRYPTION_KEY=
AP_JWT_SECRET=

# Execution
AP_EXECUTION_MODE=UNSANDBOXED
AP_FLOW_TIMEOUT_SECONDS=600

# Privacy / external services
AP_TELEMETRY_ENABLED=false

# Leave semantic tool-search disabled unless explicitly configured later.
AP_TOOL_SEARCH_ENABLED=false
AP_OPENAI_API_KEY=
