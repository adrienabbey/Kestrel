# -----------------------------------------------------------------------------
# Activepieces
# -----------------------------------------------------------------------------

# Public/browser-facing URL for Activepieces.
#
# IMPORTANT: With a separate worker, this address must be reachable from both
# the user's browser and the worker when Activepieces advertises it as its
# canonical/public URL.
#
# Use a stable hostname or IP for the Docker host. Do not use localhost.
#
# Example:
# AP_FRONTEND_URL=http://your-hostname.example:8080
AP_FRONTEND_URL=

AP_ENVIRONMENT=prod

# Activepieces database
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=

# Redis
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379

# Security secrets
AP_ENCRYPTION_KEY=
AP_JWT_SECRET=

# Dedicated worker authentication
AP_WORKER_TOKEN=

# Execution
AP_EXECUTION_MODE=SANDBOX_CODE_ONLY
AP_WORKER_CONCURRENCY=1
AP_FLOW_TIMEOUT_SECONDS=600

# Privacy / external services
AP_TELEMETRY_ENABLED=false

# Leave semantic tool-search disabled unless explicitly configured later.
AP_TOOL_SEARCH_ENABLED=false
